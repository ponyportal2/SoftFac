{
  "name": "softfac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Pi-native software factory: continuous implementer/reviewer sessions, architecture gates, and GitHub issue policy.",
  "bin": {
    "softfac": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test tests/**/*.test.ts",
    "test:watch": "tsx --test --watch tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "softfac": "tsx src/cli.ts"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
